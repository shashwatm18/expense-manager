# ==========================================
# 3-Tier Expense Manager Environment Variables
# ==========================================

# Port for the Node.js Express application (default: 3000)
PORT=3000

# PostgreSQL Connection String (Option 1 - Connection URL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/expense_db"

# PostgreSQL Individual Parameters (Option 2 - Parameter-based)
PGHOST="localhost"
PGPORT=5432
PGUSER="postgres"
PGPASSWORD="postgres"
PGDATABASE="expense_db"

# Optional Gemini API Key
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# App URL
APP_URL="http://localhost:3000"

